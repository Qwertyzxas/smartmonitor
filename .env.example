# Copy to .env and adjust. Every variable is optional: docker-compose.yml has defaults.

# --- PostgreSQL ---
POSTGRES_USER=smartmonitor
POSTGRES_PASSWORD=smartmonitor
POSTGRES_DB=smartmonitor

# --- Auth ---
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_TTL_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- AI agent (OpenRouter) ---
# Without a key the local scikit-learn fallback classifier is used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# --- Telegram reports (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_HOUR_UTC=9

# --- Monitoring / automation ---
INCIDENT_THRESHOLD=2
SYSTEM_TESTS_INTERVAL_MINUTES=60
# Optional external API that receives executed agent commands (POST JSON)
ACTION_WEBHOOK_URL=
# Live OpenRouter call inside hourly self-tests (only when a key is set)
QA_LIVE_LLM=true
SEED_DEMO=true
LOG_LEVEL=INFO

# --- Ports on the host ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
